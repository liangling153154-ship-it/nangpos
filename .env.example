# ============================================================
# NÂNG CAFÉ — CẤU HÌNH SERVER (RAILWAY)
# Sao chép file này thành .env khi chạy local, hoặc nhập vào
# Railway → Service → Variables khi deploy.
# ============================================================

# Cổng server (Railway tự cấp PORT, local mặc định 3000)
PORT=3000
NODE_ENV=development

# URL công khai của web (dùng để gắn link mở nhanh trong thông báo ntfy)
PUBLIC_URL=http://localhost:3000

# PostgreSQL (Railway tự cấp DATABASE_URL khi gắn dịch vụ Postgres)
# Để trống khi chạy local -> server tự dùng PGlite (PostgreSQL nhúng) tại ./data/pgdata
DATABASE_URL=

# Đăng nhập trang quản lý (/admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=thay_mat_khau_manh_tai_day
# Chuỗi bí mật ký cookie phiên đăng nhập (tối thiểu 32 ký tự ngẫu nhiên)
SESSION_SECRET=thay_chuoi_bi_mat_session_toi_thieu_32_ky_tu

# Mã xác thực giữa Máy tính quán (shop-agent) và Server Railway
SHOP_AGENT_SECRET=thay_ma_bi_mat_may_tinh_quan_tai_day

# Tài khoản VietQR nhận chuyển khoản (BIDV — Hộ kinh doanh Nâng Café)
# Mã BIN BIDV: 970418
VIETQR_BANK_BIN=970418
VIETQR_BANK_NAME=BIDV - CN Cao Bằng
VIETQR_ACCOUNT_NO=nhap_so_tai_khoan_bidv_tai_day
VIETQR_ACCOUNT_NAME=HO KINH DOANH NANG CAFE

# Thông báo ntfy sang điện thoại chủ quán
# Chọn tên topic khó đoán (ví dụ: nang-cafe-cb-9x7k2m4p) để tránh người lạ nghe lén
NTFY_BASE_URL=https://ntfy.sh
NTFY_TOPIC=nang-cafe-thay-bang-topic-bi-mat
# Để trống nếu dùng ntfy.sh công khai; điền Bearer token nếu dùng topic có bảo vệ
NTFY_TOKEN=

# In đơn chuyển khoản chưa xác nhận tiền hay chỉ in sau khi xác nhận tiền?
# false (khuyên dùng): Đơn COD tự in ngay; đơn chuyển khoản tự in ngay khi chủ quán bấm "Xác nhận tiền" (hoặc SePay webhook).
# true: In phiếu ngay khi khách vừa tạo đơn chuyển khoản (trên phiếu ghi rõ CHỜ XÁC NHẬN TIỀN).
PRINT_UNPAID_TRANSFER=false

# [NÂNG CẤP SAU] SePay Webhook (để trống nếu chưa gắn SePay)
SEPAY_WEBHOOK_SECRET=
