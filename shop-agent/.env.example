# ============================================================
# NÂNG CAFÉ — CẤU HÌNH MÁY TÍNH QUÁN (WINDOWS SHOP AGENT)
# Sao chép file này thành .env trong thư mục shop-agent/
# ============================================================

# Địa chỉ web Nâng Café trên Railway (không có dấu / ở cuối)
SERVER_URL=https://ten-app-cua-ban.up.railway.app

# Mã bí mật — PHẢI KHỚP với SHOP_AGENT_SECRET trên Railway
SHOP_AGENT_SECRET=thay_ma_bi_mat_may_tinh_quan_tai_day

# Chế độ máy in:
#   windows    = In trực tiếp qua driver Windows (khuyên dùng cho máy in USB Xprinter/Epson, hỗ trợ tiếng Việt có dấu 100%)
#   escpos-tcp = In qua mạng LAN (TCP port 9100)
#   mock       = Chế độ thử nghiệm (lưu phiếu thành file trong printed-receipts/, không tốn giấy)
PRINTER_MODE=windows

# Tên máy in trong Windows (Control Panel -> Devices and Printers), ví dụ: XP-80C hoặc POS-58
# Để trống để dùng máy in mặc định của Windows
PRINTER_NAME=

# Khổ giấy in nhiệt: 80 (80mm - phổ biến) hoặc 58 (58mm - nhỏ)
PRINTER_PAPER_MM=80

# Chỉ dùng khi PRINTER_MODE=escpos-tcp
PRINTER_HOST=192.168.1.200
PRINTER_PORT=9100

# Bật/tắt âm thanh chuông + đọc "Đơn mới" bằng tiếng Việt
AUDIO_ENABLED=true

# Chu kỳ tự kiểm tra đơn chưa in (ms), phòng khi rớt gói WebSocket
RECONCILE_INTERVAL_MS=25000
